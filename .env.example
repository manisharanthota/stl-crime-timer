# Copy to .env and fill in values.
DATABASE_URL=sqlite:///./stl_crime.db
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Requests per minute; requests are spaced 60/RPM + 1 seconds apart.
GEMINI_RPM=5
# Required for /admin endpoints (sent as the X-Admin-Token header); admin is disabled when empty.
ADMIN_TOKEN=
