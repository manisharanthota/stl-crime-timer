# Copy to .env and fill in values. Never commit .env.
# Local SQLite by default. For Postgres (Supabase), paste the Session pooler URI as-is
# (postgresql://... is switched to the psycopg driver automatically).
DATABASE_URL=sqlite:///./stl_crime.db
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
# Providers tried in order for every batch, as provider:model (providers: gemini, groq).
# A provider out of daily quota, overloaded (503) on 2 batches, or rate limited past
# retries is skipped for the rest of the run. Empty = GEMINI_MODEL, then
# GEMINI_FALLBACK_MODEL. Example:
# LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite
LLM_CHAIN=
GROQ_API_KEY=
# Groq free tier limits for your model (see console.groq.com/settings/limits). Batches
# are sized to stay under 80% of GROQ_TPM.
GROQ_RPM=30
GROQ_TPM=8000
# Output tokens per minute, for models with a separate output limit (qwen: 1000; see the
# limits page). Batches shrink so one reply fits (1000 -> 5 items). Empty = no limit;
# a 429 naming an OTPM limit still sets it for the rest of the run.
GROQ_OTPM=
# Empty = the least reasoning the model allows: "none" for qwen, "low" for gpt-oss
# (reasoning tokens count toward the per-minute limits). Not sent for other models.
GROQ_REASONING_EFFORT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used when GEMINI_MODEL is overloaded (one try per batch after its 503 retries) or out of
# daily quota (takes over for the rest of the run). Empty = no fallback.
# Pick a different model than GEMINI_MODEL (free-tier quota is per model).
GEMINI_FALLBACK_MODEL=
# Requests per minute; requests are spaced 60/RPM + 1 seconds apart.
GEMINI_RPM=5
# Required for /admin endpoints (sent as the X-Admin-Token header); admin is disabled when empty.
ADMIN_TOKEN=
# Discord webhook for alerts (source down, no successful run in 30 min, LLM quota, stuck
# items, incidents needing review). Empty = alerts are only logged.
ALERT_WEBHOOK_URL=
# 1 = also alert on every new confirmed incident (type, location, article link).
ALERT_ON_NEW_INCIDENT=0
# Hours before the same alert can be sent again.
ALERT_COOLDOWN_HOURS=6
# Discord webhook for the page's feedback box (can be a different channel than alerts).
# Never sent to the browser. Empty = the feedback box answers "not configured".
FEEDBACK_WEBHOOK_URL=
# false = log to stdout only (GitHub Actions); otherwise also logs/pipeline.log.
LOG_TO_FILE=true
# Optional, tests only: a THROWAWAY Postgres database. When set, pytest also runs the
# suite on Postgres (in temporary pytest_* schemas). Never your real DATABASE_URL.
# DATABASE_URL_TEST=postgresql://postgres:PASSWORD@localhost:5432/stl_crime_test
