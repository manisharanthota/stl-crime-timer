# Copy to .env and fill in values.
DATABASE_URL=sqlite:///./stl_crime.db
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used when GEMINI_MODEL is overloaded (one try per batch after its 503 retries) or out of
# daily quota (takes over for the rest of the run). Empty = no fallback.
# Pick a different model than GEMINI_MODEL (free-tier quota is per model).
GEMINI_FALLBACK_MODEL=
# Requests per minute; requests are spaced 60/RPM + 1 seconds apart.
GEMINI_RPM=5
# Required for /admin endpoints (sent as the X-Admin-Token header); admin is disabled when empty.
ADMIN_TOKEN=
# Discord webhook for alerts (source down, no successful run in 30 min, LLM quota, stuck
# items, incidents needing review). Empty = alerts are only logged.
ALERT_WEBHOOK_URL=
# 1 = also alert on every new confirmed incident (type, location, article link).
ALERT_ON_NEW_INCIDENT=0
# Hours before the same alert can be sent again.
ALERT_COOLDOWN_HOURS=6
